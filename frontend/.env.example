# Public origin of the Yatra API, with no trailing slash and no path.
# The browser calls the API directly (a Next rewrite would buffer the streamed plan).
# This value is baked in when the frontend is BUILT: change it, then redeploy.
#
# Local:       http://localhost:8000
# Production:  https://your-api-host.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000
