# Local run: copy this file to .streamlit/secrets.toml (git-ignored) and fill in the keys.
# Streamlit Community Cloud: paste the same lines into Manage app > Settings > Secrets.
# Every top-level line becomes an environment variable, with the name in upper case.

# Required: the main model is deepseek:deepseek-flash
DEEPSEEK_API_KEY = "paste-your-deepseek-key"

# Recommended: the fallback model openai:gpt-4.1-mini, used when the main model fails
OPENAI_API_KEY = "paste-your-openai-key"

# Optional: live hotel search. Without it the Hotels section says search is not configured,
# and the rest of the plan still works.
# TAVILY_API_KEY = "paste-your-tavily-key"

# Optional: set to false to run the tools in-process instead of as MCP server subprocesses
# (uses less memory)
# MCP_ENABLED = false
