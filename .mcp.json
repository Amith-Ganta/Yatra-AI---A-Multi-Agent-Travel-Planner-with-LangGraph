{
  "mcpServers": {
    "yatra-hotels": {
      "command": "python",
      "args": ["-m", "src.mcp_servers.hotels"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "yatra-flights": {
      "command": "python",
      "args": ["-m", "src.mcp_servers.flights"],
      "env": {}
    },
    "yatra-weather": {
      "command": "python",
      "args": ["-m", "src.mcp_servers.weather"],
      "env": {}
    }
  }
}
