# Yatra AI Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env with real values: .gitignore protects this file
#
# Every variable below is read by the code. Settings that nothing reads were removed on purpose,
# so that setting one here is never a silent no-op.

# ─────────────────────────────────────────────────────────────────
# LLM API KEYS
# ─────────────────────────────────────────────────────────────────

# DeepSeek (default runtime LLM: the supervisor and every agent call it)
# Get key: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI: the first fallback when DeepSeek fails, and the judge in the evals.
# Without this key a DeepSeek outage fails the request instead of falling back.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────────────────────────
# TRAVEL DATA API KEYS
# ─────────────────────────────────────────────────────────────────

# Tavily (hotel search, served by the hotels MCP server). Optional: without it the hotels server
# is not started, the Hotels section says search is not configured, and the rest of the plan
# still works.
# Get key: https://www.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Weather uses Open-Meteo, which is free and needs no key.
# Flights are sample data for now (labelled "mock" in the plan), so no flight key is read.

# ─────────────────────────────────────────────────────────────────
# MCP TOOL SERVERS AND HUMAN APPROVAL
# ─────────────────────────────────────────────────────────────────

# The flight, hotel and weather tools run as MCP servers (src/mcp_servers), started as
# subprocesses and called through langchain-mcp-adapters. false runs the same tools in-process.
# Each server costs roughly 60 MB of memory: set this to false on a very small host.
MCP_ENABLED=true
# Seconds to wait for each server to start and list its tools. A server that is too slow is
# skipped and its tool runs in-process instead.
MCP_STARTUP_TIMEOUT=20
# Seconds one MCP tool call may take before the in-process fallback runs
MCP_CALL_TIMEOUT=25

# How many times a rejected plan is rewritten from the feedback before the last draft is
# returned unapproved
MAX_REVISIONS=3

# ─────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string: conversation threads, messages and approvals, and the LangGraph
# checkpoints that let a run pause for approval and survive a restart.
# Format: postgresql://user:password@host:port/database
# The short postgres:// form that some hosts hand out is accepted too.
# Local dev: postgresql://postgres:postgres@localhost:5432/yatra
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yatra

# ─────────────────────────────────────────────────────────────────
# APPLICATION CONFIG
# ─────────────────────────────────────────────────────────────────

APP_ENV=development
# APP_DEBUG=true turns on auto-reload: set it to false in any deployed environment
APP_DEBUG=true
APP_HOST=0.0.0.0
# Hosts that inject PORT (Render, Railway, Cloud Run) are honoured when APP_PORT is unset
APP_PORT=8000

# CORS: browser origins allowed to call the API, comma separated, no trailing slash.
# A deployed frontend MUST be listed here, or the browser blocks every call.
# The defaults below cover local development only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional pattern for origins that change, such as Vercel preview deployments. Leave empty to disable.
# Example: https://yatra-ai-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# LLM model selection. One name per model, written provider:model.
#   deepseek:deepseek-flash   cheap and fast (the default runtime model)
#   deepseek:deepseek-chat    the older DeepSeek name; DeepSeek has announced its retirement
#   openai:gpt-4.1-mini       the first fallback
#   openai:gpt-4o-mini        the eval judge
LLM_RUNTIME_MODEL=deepseek:deepseek-flash
LLM_EVAL_MODEL=openai:gpt-4o-mini

# Models tried, in order, when the runtime model fails (rate limit, outage, timeout). Comma
# separated. A model whose API key is missing is skipped. Leave the default unless you have a reason.
LLM_FALLBACK_MODELS=openai:gpt-4.1-mini,deepseek:deepseek-flash
# Seconds one model call may take before the next model in the chain is tried
LLM_REQUEST_TIMEOUT=45
# Retries on the SAME model before moving on. Keep it low: the fallback is the retry.
LLM_MAX_RETRIES=1

# ─────────────────────────────────────────────────────────────────
# EVALUATION CONFIG
# ─────────────────────────────────────────────────────────────────

# Eval thresholds (gate)
EVAL_SAFETY_THRESHOLD=0.95
EVAL_FACTUALITY_THRESHOLD=0.90
EVAL_BUDGET_THRESHOLD=0.95
EVAL_CODE_COVERAGE_THRESHOLD=0.80

# Eval judge rate limiting (tokens per minute)
EVAL_JUDGE_TPM=90000

# The DeepEval agent evals (python -m evals.eval_agent) need DEEPSEEK_API_KEY and OPENAI_API_KEY
# above. Optional: judge with another OpenAI model than LLM_EVAL_MODEL.
# EVAL_JUDGE_MODEL=gpt-4.1-mini

# ─────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────

# Logs are always JSON on stdout. This only sets the level.
LOG_LEVEL=INFO
