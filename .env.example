# Yatra AI Environment Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env with real values — .gitignore protects this file

# ─────────────────────────────────────────────────────────────────
# LLM API KEYS
# ─────────────────────────────────────────────────────────────────

# Groq (primary runtime LLM)
# Get key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (fallback runtime + eval judge)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek (fallback fallback)
# Get key: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ─────────────────────────────────────────────────────────────────
# TRAVEL DATA API KEYS
# ─────────────────────────────────────────────────────────────────

# Tavily (web search + hotel info)
# Get key: https://www.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack (flight data)
# Get key: https://aviationstack.com/
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeatherMap (weather forecasts)
# Get key: https://openweathermap.org/api
# NOTE: Open-Meteo (https://open-meteo.com/) is FREE and needs NO KEY
# If using Open-Meteo, leave this empty or omit
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ─────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (LangGraph checkpointer)
# Format: postgresql://user:password@host:port/database
# Local dev: postgresql://postgres:postgres@localhost:5432/yatra
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yatra
DATABASE_ECHO=false

# ─────────────────────────────────────────────────────────────────
# LANGCHAIN / TRACING
# ─────────────────────────────────────────────────────────────────

# LangChain tracing (optional, for debugging)
# Get key: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=yatra-ai

# ─────────────────────────────────────────────────────────────────
# APPLICATION CONFIG
# ─────────────────────────────────────────────────────────────────

# FastAPI app
APP_NAME=Yatra AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM Model Selection
# Options: deepseek:deepseek-chat, openai:gpt-4o-mini, groq:llama-3.1-70b-versatile
LLM_RUNTIME_MODEL=deepseek:deepseek-chat
LLM_EVAL_MODEL=openai:gpt-4o-mini

# Latency + Cost Limits
MAX_TRIP_DRAFT_SECONDS=15
MAX_TOKENS_PER_AGENT=2000
MAX_COST_PER_TRIP_USD=1.00

# ─────────────────────────────────────────────────────────────────
# EVALUATION CONFIG
# ─────────────────────────────────────────────────────────────────

# Eval thresholds (gate)
EVAL_SAFETY_THRESHOLD=0.95
EVAL_FACTUALITY_THRESHOLD=0.90
EVAL_BUDGET_THRESHOLD=0.95
EVAL_CODE_COVERAGE_THRESHOLD=0.80

# Eval judge rate limiting (tokens per minute)
EVAL_JUDGE_TPM=90000

# ─────────────────────────────────────────────────────────────────
# LOGGING + TELEMETRY
# ─────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# ─────────────────────────────────────────────────────────────────
# DEVELOPMENT ONLY
# ─────────────────────────────────────────────────────────────────

# Set to 'true' to use mocked MCP servers (for testing without API keys)
USE_MOCK_MCP=false

# Set to 'true' to use in-memory cache (development only)
ENABLE_CACHE=false
CACHE_TTL_SECONDS=300
